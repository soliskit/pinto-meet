{
  "name": "pinto-meet",
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "website": "https://meet.pintopinto.org/",
  "logo": "/favicon.ico",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "dev": "next dev -p 4000",
    "vercel": "npx vercel dev --listen 4000 --debug",
    "prod": "npx next build --profile && npx next start -p 4000",
    "lint": "eslint .",
    "test": "node ./test/server.js --trace-warnings",
    "format": "prettier --write ."
  },
  "dependencies": {
    "haikunator": "^2.1.2",
    "next": "^16.3.6",
    "peerjs": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "express": "^5.2.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "author": "David Solis",
  "repository": "https://github.com/pinto-pinto/pinto-meet",
  "description": "Video conferencing for the rest of us, join a room to get started today.",
  "keywords": [
    "FaceTime",
    "Zoom",
    "Video Conferencing",
    "Meet",
    "WebRTC",
    "TailwindCSS",
    "Next.js"
  ],
